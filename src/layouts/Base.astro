---
// 全ページ共通の枠（ヘッダー・フッター・言語切替）。ページごとに title と description を渡す
import '../styles/global.css';
import { SITE } from '../lib/site';
import SnsLinks from '../components/SnsLinks.astro';

interface Props {
  title: string;
  description: string;
  image?: string; // SNSで共有したときの画像（/images/... または https://...）
}
const { title, description, image } = Astro.props;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const siteName = SITE.name;
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"Pickleball Tokyo","url":"https://www.pickleball-tokyo.com/"}</script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <!-- Google アナリティクス（GA4）。Google が配布している標準のタグをそのまま使う -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DJ5EQR4TPG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DJ5EQR4TPG');
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/" aria-label={SITE.name}><img src="/favicon.svg" alt="" width="30" height="30" /><span class="logo-word">Pickleball<span class="logo-accent">Tokyo</span></span></a>
      <nav>
        <a href="/#courts" data-ja="コート" data-en="Courts">コート</a>
        <a class="nav-sub" href="/#areas" data-ja="エリア" data-en="Areas">エリア</a>
        <a href="/blog/" data-ja="記事" data-en="Articles">記事</a>
        <a class="nav-cta" href="/contact/?type=court" data-ja="コート掲載<span class='nav-cta-free'>基本無料</span>" data-en="List your court<span class='nav-cta-free'>Free</span>">コート掲載<span class="nav-cta-free">基本無料</span></a>
        <div class="lang-switch">
          <button id="jpBtn" class="active" type="button">JP</button>
          <button id="enBtn" type="button">EN</button>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="footer">
      <div class="footer-inner">
        <div>
          <p class="footer-name">{SITE.name}</p>
          <p data-ja="東京近郊のピックルボールコートまとめ。ピックルボールプレイヤーのために定期的に更新しています。" data-en="Pickleball courts in and around Tokyo, updated regularly for players.">
            東京近郊のピックルボールコートまとめ。ピックルボールプレイヤーのために定期的に更新しています。
          </p>
          <SnsLinks place="footer" />
        </div>
        <nav class="footer-nav" aria-label="フッター">
          <a href="/#courts" data-ja="コート一覧" data-en="Courts">コート一覧</a>
          <a href="/#areas" data-ja="エリア" data-en="Areas">エリア</a>
          <a href="/blog/" data-ja="記事" data-en="Articles">記事</a>
          <a href="/contact/?type=court" data-ja="コート掲載のご依頼" data-en="List your court">コート掲載のご依頼</a>
          <a href="/contact/" data-ja="お問い合わせ" data-en="Contact">お問い合わせ</a>
          <a href="/privacy/" data-ja="プライバシーポリシー" data-en="Privacy">プライバシーポリシー</a>
        </nav>

      </div>
      <p class="footer-note" data-ja="料金・営業時間は変わることがあります。最新情報は各施設の公式サイトでご確認ください。" data-en="Prices and hours may change. Please check each facility's official site.">料金・営業時間は変わることがあります。最新情報は各施設の公式サイトでご確認ください。</p>
    </footer>

    <script is:inline>
      // 送客計測：予約・空き状況・地図リンクのクリックを /api/track に送る（個人情報は送らない）
      (function () {
        function send(e) {
          if (e.type === 'auxclick' && e.button !== 1) return;
          var a = e.target.closest && e.target.closest('a[data-track]');
          if (!a) return;
          var card = a.closest('[data-court-item]');
          var data = JSON.stringify({
            kind: a.dataset.track,
            from: a.dataset.trackFrom || '',
            courtId: a.dataset.courtId || (card && card.dataset.id) || '',
            courtName: a.dataset.courtName || (card && card.dataset.name) || '',
            url: a.href,
            page: location.pathname,
          });
          try { navigator.sendBeacon('/api/track', data); } catch (err) {}
          if (window.gtag) {
            var d = JSON.parse(data);
            gtag('event', 'court_link_click', { link_kind: d.kind, link_place: d.from, court_id: d.courtId, court_name: d.courtName });
          }
        }
        document.addEventListener('click', send, true);
        // SNS リンクのクリックは GA4 にだけ送る
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[data-sns]');
          if (a && window.gtag) gtag('event', 'sns_click', { sns: a.dataset.sns, sns_place: a.dataset.snsPlace });
        }, true);
        document.addEventListener('auxclick', send, true);
      })();
    </script>
    <script is:inline>
      // 日本語/英語の切り替え（data-ja / data-en を持つ要素を書き換える）
      (function () {
        var jp = document.getElementById('jpBtn');
        var en = document.getElementById('enBtn');
        function setLanguage(lang) {
          document.documentElement.lang = lang;
          document.querySelectorAll('[data-ja]').forEach(function (el) {
            el.innerHTML = lang === 'ja' ? el.dataset.ja : el.dataset.en;
          });
          jp.classList.toggle('active', lang === 'ja');
          en.classList.toggle('active', lang === 'en');
          try { localStorage.setItem('lang', lang); } catch (e) {}
        }
        jp.onclick = function () { setLanguage('ja'); };
        en.onclick = function () { setLanguage('en'); };
        var saved = 'ja';
        try { saved = localStorage.getItem('lang') || 'ja'; } catch (e) {}
        setLanguage(saved);
      })();
    </script>
  </body>
</html>
