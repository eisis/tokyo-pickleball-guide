---
// 記事の一覧画面（記事トップ・カテゴリ別・タグ別で共通）。
// 上から：見出し → 検索窓 → カテゴリのタブ → タグ → 記事カード
import PostCard from './PostCard.astro';
import { POST_CATEGORIES, categoryUrl, tagUrl, type Post, type PostCategory } from '../lib/posts';

interface Props {
  posts: Post[]; // この画面に出す記事（新しい順）
  allPosts: Post[]; // タグやカテゴリの件数を数えるための全記事
  eyebrow: string;
  title: string;
  lead: string;
  activeCategory?: PostCategory;
  activeTag?: string;
}
const { posts, allPosts, eyebrow, title, lead, activeCategory, activeTag } = Astro.props;
const isTop = !activeCategory && !activeTag;

const catCounts = Object.fromEntries(
  (Object.keys(POST_CATEGORIES) as PostCategory[]).map((c) => [c, allPosts.filter((p) => p.data.category === c).length])
);
const tagCounts = new Map<string, number>();
allPosts.forEach((p) => p.data.tags.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const tags = [...tagCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja'));

// 記事トップでは「featured」（なければ最新）を大きく出す
const feature = isTop ? posts.find((p) => p.data.featured) ?? posts[0] : undefined;
const rest = posts.filter((p) => p !== feature);
---

<header class="blog-head">
  <div class="blog-head-inner">
    <nav class="crumbs" aria-label="パンくず">
      <a href="/">トップ</a><span aria-hidden="true">›</span>
      {isTop ? <span>記事</span> : <><a href="/blog/">記事</a><span aria-hidden="true">›</span><span>{title}</span></>}
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="blog-title">{title}</h1>
    <p class="blog-lead">{lead}</p>

    <label class="blog-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input id="post-q" type="search" placeholder="記事を検索（例：初心者、豊洲、レンタル）" aria-label="記事を検索" autocomplete="off" />
    </label>

    <nav class="cat-tabs" aria-label="カテゴリ">
      <a href="/blog/" class={isTop ? 'active' : ''} aria-current={isTop ? 'page' : undefined}>すべて <span class="n">{allPosts.length}</span></a>
      {(Object.keys(POST_CATEGORIES) as PostCategory[]).filter((c) => catCounts[c] > 0).map((c) => (
        <a href={categoryUrl(c)} class={activeCategory === c ? 'active' : ''} aria-current={activeCategory === c ? 'page' : undefined}>
          {POST_CATEGORIES[c].ja} <span class="n">{catCounts[c]}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<main class="blog-main">
  <p class="post-count" id="post-count" hidden></p>

  {feature && <div class="blog-feature"><PostCard post={feature} variant="feature" /></div>}

  {rest.length > 0 && <div class="post-cards">{rest.map((p) => <PostCard post={p} />)}</div>}

  {posts.length === 0 && (
    <div class="empty">
      <p>このカテゴリの記事はまだありません。準備中です。</p>
      <a class="chip" href="/blog/">すべての記事を見る</a>
    </div>
  )}
  <div class="empty" id="post-empty" hidden>
    <p>「<span id="post-empty-q"></span>」に合う記事は見つかりませんでした。</p>
    <button type="button" class="chip" id="post-clear">検索をクリア</button>
  </div>

  {tags.length > 0 && (
    <section class="tag-cloud" aria-label="タグ">
      <h2>タグから探す</h2>
      <div class="tag-list">
        {tags.map(([t, n]) => (
          <a href={tagUrl(t)} class={activeTag === t ? 'active' : ''}>#{t} <span class="n">{n}</span></a>
        ))}
      </div>
    </section>
  )}
</main>

<script>
  // 記事の絞り込み検索（この画面に出ている記事の中から探す）。?q=〇〇 で開くと最初から検索した状態になる
  const input = document.getElementById('post-q') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>('[data-post-item]')];
  const count = document.getElementById('post-count')!;
  const empty = document.getElementById('post-empty')!;

  function run() {
    const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let n = 0;
    items.forEach((el) => {
      const ok = words.every((w) => (el.dataset.search ?? '').includes(w));
      el.hidden = !ok;
      if (ok) n++;
    });
    document.querySelector('.blog-feature')?.toggleAttribute('hidden', !!words.length && !document.querySelector('.blog-feature [data-post-item]:not([hidden])'));
    count.hidden = !words.length;
    count.textContent = `${n}件の記事`;
    empty.hidden = !words.length || n > 0;
    document.getElementById('post-empty-q')!.textContent = input.value.trim();
  }
  input.addEventListener('input', run);
  document.getElementById('post-clear')!.addEventListener('click', () => { input.value = ''; run(); input.focus(); });
  const q = new URLSearchParams(location.search).get('q');
  if (q) { input.value = q; run(); }
</script>
