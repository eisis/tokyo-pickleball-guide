---
// コート1件分のカード。一覧ページや記事の関連コートで使い回す
import { PREFECTURES, ENVIRONMENTS, CATEGORIES, courtUrl, mapUrl, bookingLabel, isNew, type Court } from '../lib/courts';

interface Props {
  court: Court;
}
const { court } = Astro.props;
const d = court.data;
const label = bookingLabel(court);
const detail = courtUrl(court);
---

<article class="card" data-court-item data-pref={d.prefecture} data-env={d.environment.join(' ')}>
  <a href={detail}>
    {d.image ? (
      <img class="facility-image" src={d.image} alt={d.name} loading="lazy" />
    ) : (
      <div class="facility-image image-placeholder" aria-hidden="true">🏓</div>
    )}
  </a>
  <div class="card-body">
    <h3><a href={detail}>{d.name}</a>{isNew(court) && <span class="new-label">NEW</span>}</h3>
    <div class="location">
      <span data-ja={`@${d.area.ja}`} data-en={`@${d.area.en}`}>@{d.area.ja}</span>
      <span class={`tag ${d.prefecture}`}>{PREFECTURES[d.prefecture].en}</span>
      {d.environment.map((e) => <span class={`tag ${e}`}>{ENVIRONMENTS[e].en}</span>)}
      {d.category !== 'dedicated' && (
        <span class="tag category" data-ja={CATEGORIES[d.category].ja} data-en={CATEGORIES[d.category].en}>{CATEGORIES[d.category].ja}</span>
      )}
    </div>
    <p class="description" data-ja={d.description.ja} data-en={d.description.en}>{d.description.ja}</p>
    <a class="button" href={d.booking.url} target="_blank" rel="noopener" data-ja={label.ja} data-en={label.en}>{label.ja}</a>
    {d.availabilityUrl && (
      <a class="button secondary" href={d.availabilityUrl} target="_blank" rel="noopener" data-ja="空き状況を見る" data-en="Check Availability">空き状況を見る</a>
    )}
    <a class="map-button" href={mapUrl(court)} target="_blank" rel="noopener">📍 Google Map</a>
  </div>
</article>
