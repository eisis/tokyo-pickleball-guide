---
// SNS（Instagram・X）へのリンク。アイコンは単色（文字色に合わせる）で、主張しすぎない見せ方にしている。
//   place="footer"  … フッター用（アイコンだけ）
//   place="article" … 記事の最後用（アイコン＋アカウント名）
// クリックは GA4 に sns_click として送る（Base.astro のスクリプト）
interface Props { place: 'footer' | 'article' }
const { place } = Astro.props;
const accounts = [
  { id: 'instagram', label: 'Instagram', handle: '@pickleballtokyo', url: 'https://www.instagram.com/pickleballtokyo/' },
  { id: 'x', label: 'X', handle: '@PickleballTokyo', url: 'https://x.com/PickleballTokyo' },
];
---
<div class={`sns sns-${place}`}>
  {accounts.map((a) => (
    <a href={a.url} target="_blank" rel="noopener" aria-label={`${a.label}（${a.handle}）`} data-sns={a.id} data-sns-place={place}>
      {a.id === 'instagram' ? (
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
      )}
      {place === 'article' && <span>{a.handle}</span>}
    </a>
  ))}
</div>
