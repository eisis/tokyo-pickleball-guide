---
// マイパドル（/my-paddle/）：自分だけのピックルボールパドルをデザインして注文できるページ
// ・製作は ZEAMI Goods（https://zeamigoods.com/product/115）に、当サイトが1本ずつ代理で発注する受注制
// ・申し込みはお問い合わせフォームの「マイパドル」種別（api/_lib/contact-types.js の paddle）
// ・ORDER_OPEN を true にし、paddle 種別の enabled を外すと受付開始。その前に特定商取引法に基づく表示ページを公開すること
import Base from '../layouts/Base.astro';

const ORDER_OPEN = false; // 受付を始めるときに true にする
const PRICE = '16,800';

const templates = [
  { id: 'dot', name: 'ドット' },
  { id: 'wave', name: 'ウェーブ' },
  { id: 'bloom', name: 'フラワー' },
  { id: 'mono', name: 'イニシャル' },
];
const palettes = [
  { id: 'peach', name: 'ピーチ', bg: '#ffd9cf', a: '#ff8a73', b: '#fff4ec', ink: '#7a2e22' },
  { id: 'mint', name: 'ミント', bg: '#cdf3e6', a: '#14b8a6', b: '#f2fffb', ink: '#0f4d45' },
  { id: 'lilac', name: 'ライラック', bg: '#e4dcff', a: '#8b74e8', b: '#f8f5ff', ink: '#3b2b7a' },
  { id: 'lemon', name: 'レモン', bg: '#f4f7b8', a: '#c9d82b', b: '#fffde8', ink: '#4a5310' },
  { id: 'night', name: 'ナイト', bg: '#1d2b3a', a: '#d7f23a', b: '#33475b', ink: '#f4f7ea' },
];
---

<Base title="マイパドル｜自分だけのピックルボールパドルを1本から" description="好きな柄と色、名前を選んで、自分だけのピックルボールパドルを1本から作れます。練習やサークル、おそろいや贈り物に。">
  <main class="container mp">
    <header class="mp-hero">
      <p class="mp-eyebrow">My Paddle</p>
      <h1>自分だけのパドルを、1本から。</h1>
      <p class="mp-lead">柄と色を選んで名前を入れるだけで、世界に一本のピックルボールパドルが届きます。サークルのおそろいや、ピックルボール仲間への贈り物にもどうぞ。</p>
    </header>

    <section class="mp-studio" aria-label="デザインする">
      <div class="mp-preview">
        <svg id="paddle" viewBox="0 0 220 440" role="img" aria-label="パドルのデザインイメージ" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <clipPath id="face"><rect x="10" y="10" width="200" height="290" rx="64" ry="64" /></clipPath>
          </defs>
          <rect x="88" y="290" width="44" height="140" rx="14" fill="#2b2b2b" />
          <rect x="88" y="300" width="44" height="6" fill="#444" />
          <g clip-path="url(#face)" id="art"></g>
          <rect x="10" y="10" width="200" height="290" rx="64" ry="64" fill="none" stroke="#2b2b2b" stroke-width="7" />
        </svg>
        <p class="mp-note">画面のイメージです。いただいたデザインは、印刷前にこちらで整えてから見本をお送りします。</p>
      </div>

      <form class="mp-controls" id="ctl" onsubmit="return false">
        <fieldset>
          <legend>1. 柄を選ぶ</legend>
          <div class="mp-chips">
            {templates.map((t, i) => (
              <label><input type="radio" name="tpl" value={t.id} checked={i === 0} /><span>{t.name}</span></label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>2. 色を選ぶ</legend>
          <div class="mp-swatches">
            {palettes.map((p, i) => (
              <label title={p.name}>
                <input type="radio" name="pal" value={p.id} checked={i === 0} />
                <span style={`background:linear-gradient(135deg,${p.bg} 50%,${p.a} 50%)`}></span>
                <small>{p.name}</small>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>3. 名前を入れる</legend>
          <input class="mp-text" id="name" type="text" maxlength="12" placeholder="例：HANA" value="HANA" />
          <p class="mp-help">英字なら12文字まで。イニシャルの柄では最初の1文字が大きく入ります。</p>
        </fieldset>
        <button type="button" class="mp-btn ghost" id="save">デザインを画像で保存</button>
      </form>
    </section>

    <section class="mp-info">
      <h2>届くまでの流れ</h2>
      <ol class="mp-flow">
        <li><b>デザインして申し込む</b><span>このページで作った画像か、使いたいイラスト・ロゴを添えて申し込みフォームから送ります。</span></li>
        <li><b>見本の確認とお支払い</b><span>印刷用に整えた見本と金額をメールでお送りします。よろしければ銀行振込でお支払いください。</span></li>
        <li><b>製作</b><span>お振込みを確認したら、提携の制作工房に発注します。工房で1本ずつ印刷・検品されます。</span></li>
        <li><b>お届け</b><span>お振込みの確認から2〜3週間ほどでお届けします。</span></li>
      </ol>

      <div class="mp-cta">
        <p class="mp-price">1本 {PRICE}円<small>（税込・送料込み）</small></p>
        {ORDER_OPEN ? (
          <a class="mp-btn" id="order" href="/contact/?type=paddle">このデザインで申し込む</a>
        ) : (
          <p class="mp-soon">お申し込みの受付は準備中です。もうすぐ始めますので、Instagram <a href="https://www.instagram.com/pickleballtokyo/" target="_blank" rel="noopener">@pickleballtokyo</a> でお知らせします。</p>
        )}
      </div>

      <h2>パドルについて</h2>
      <p>大阪の制作工房 ZEAMI Goods のオリジナルパドルを使っています。打球面はグラスファイバーにサンドブラスト加工をしたもの、芯はPPハニカムで、大きさは415×190mm、厚さ16mm、重さは220g前後です。工房によると初級〜中級の人が気持ちよく打てるように作られていて、はじめての一本にも向いています。</p>
      <p>ひとつ知っておいてほしいのは、このパドルが公認大会用の認定を受けていないことです。普段の練習やサークル、仲間内の交流戦では問題なく使えますが、大会の要項で承認パドルを指定している公式戦には使えません。公式戦に出る予定があるときは、承認済みの市販パドルを別に用意してください。</p>

      <h2>デザインとお申し込みの注意</h2>
      <p>アニメやゲームのキャラクター、スポーツチームやブランドのロゴなど、権利を持っていない画像は印刷できません。ご自分で描いたイラストや写真、権利を持っているロゴでお願いします。該当しそうなものは、こちらからご相談の連絡をします。</p>
      <p>一本ずつ作るオーダー品のため、発注後のキャンセルやデザインの変更はお受けできない場合があります。印刷のかすれや傷など、届いたものに不具合があったときは作り直してお送りします。</p>
      <p>わからないことは <a href="/contact/">お問い合わせ</a> からどうぞ。</p>
    </section>
  </main>

  <script define:vars={{ palettes }}>
    const NS = 'http://www.w3.org/2000/svg';
    const art = document.getElementById('art');
    const form = document.getElementById('ctl');
    const nameInput = document.getElementById('name');

    function el(tag, attrs) {
      const n = document.createElementNS(NS, tag);
      for (const k in attrs) n.setAttribute(k, attrs[k]);
      return n;
    }
    function label(text, p, size, y) {
      const t = el('text', { x: 110, y, 'text-anchor': 'middle', fill: p.ink, 'font-size': size, 'font-weight': 800, 'letter-spacing': 2, 'font-family': "'Bricolage Grotesque', 'Zen Kaku Gothic New', sans-serif" });
      t.textContent = text;
      return t;
    }
    function flower(cx, cy, r, p) {
      const g = el('g', {});
      for (let i = 0; i < 5; i++) {
        const a = (i / 5) * Math.PI * 2;
        g.appendChild(el('circle', { cx: cx + Math.cos(a) * r, cy: cy + Math.sin(a) * r, r: r * 0.85, fill: p.b }));
      }
      g.appendChild(el('circle', { cx, cy, r: r * 0.7, fill: p.a }));
      return g;
    }

    function draw() {
      const tpl = form.tpl.value;
      const p = palettes.find((x) => x.id === form.pal.value);
      const name = (nameInput.value || '').trim().toUpperCase();
      const order = document.getElementById('order');
      if (order) {
        const tplName = form.querySelector('input[name=tpl]:checked').nextElementSibling.textContent;
        const q = new URLSearchParams({ type: 'paddle', design: `${tplName}／${p.name}／${name || '名前なし'}`, quantity: '1' });
        order.href = `/contact/?${q}`;
      }
      art.replaceChildren(el('rect', { x: 0, y: 0, width: 220, height: 310, fill: p.bg }));

      if (tpl === 'dot') {
        for (let y = 0; y < 320; y += 34) {
          for (let x = (y / 34) % 2 ? 17 : 0; x < 230; x += 34) art.appendChild(el('circle', { cx: x, cy: y, r: 7, fill: p.a }));
        }
        art.appendChild(el('rect', { x: 30, y: 128, width: 160, height: 54, rx: 27, fill: p.b }));
        if (name) art.appendChild(label(name, p, 26, 164));
      } else if (tpl === 'wave') {
        for (let i = 0; i < 6; i++) {
          const y = 40 + i * 50;
          art.appendChild(el('path', { d: `M-10 ${y} Q 45 ${y - 26} 100 ${y} T 210 ${y} T 320 ${y} V ${y + 22} Q 265 ${y - 4} 210 ${y + 22} T 100 ${y + 22} T -10 ${y + 22} Z`, fill: i % 2 ? p.a : p.b }));
        }
        if (name) {
          art.appendChild(el('rect', { x: 40, y: 236, width: 140, height: 40, rx: 20, fill: p.bg }));
          art.appendChild(label(name, p, 20, 263));
        }
      } else if (tpl === 'bloom') {
        [[52, 60, 16], [160, 48, 11], [176, 150, 18], [44, 190, 12], [120, 238, 15], [70, 120, 8], [150, 210, 8]].forEach(([x, y, r]) => art.appendChild(flower(x, y, r, p)));
        if (name) art.appendChild(label(name, p, 24, 116));
      } else {
        art.appendChild(el('circle', { cx: 110, cy: 140, r: 78, fill: p.a }));
        art.appendChild(el('circle', { cx: 110, cy: 140, r: 66, fill: 'none', stroke: p.b, 'stroke-width': 3 }));
        const ini = label(name ? name[0] : 'P', p, 92, 172);
        ini.setAttribute('fill', p.b);
        art.appendChild(ini);
        if (name) art.appendChild(label(name, p, 16, 262));
      }
    }

    form.addEventListener('change', draw);
    nameInput.addEventListener('input', draw);
    draw();

    // SVG を PNG にして保存する
    document.getElementById('save').addEventListener('click', () => {
      const svg = document.getElementById('paddle').cloneNode(true);
      svg.setAttribute('width', 660);
      svg.setAttribute('height', 1320);
      const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(svg)], { type: 'image/svg+xml' }));
      const img = new Image();
      img.onload = () => {
        const c = document.createElement('canvas');
        c.width = 660; c.height = 1320;
        const ctx = c.getContext('2d');
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, c.width, c.height);
        ctx.drawImage(img, 0, 0, c.width, c.height);
        URL.revokeObjectURL(url);
        const a = document.createElement('a');
        a.download = `my-paddle-${form.tpl.value}-${form.pal.value}.png`;
        a.href = c.toDataURL('image/png');
        a.click();
      };
      img.src = url;
    });
  </script>

  <style>
    .mp { max-width: 980px; padding-bottom: 64px; }
    .mp-hero { text-align: center; padding: 28px 0 8px; }
    .mp-eyebrow { font-family: var(--display); color: var(--teal-dark); font-weight: 800; letter-spacing: .12em; text-transform: uppercase; font-size: 13px; margin: 0; }
    .mp-hero h1 { color: var(--navy); font-size: clamp(26px, 5vw, 38px); margin: 8px 0 12px; }
    .mp-lead { color: var(--ink-soft); max-width: 560px; margin: 0 auto; line-height: 1.9; }

    .mp-studio { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: start; margin: 28px 0 40px; background: var(--sand); border-radius: var(--radius); padding: 28px; }
    .mp-preview { text-align: center; }
    .mp-preview svg { width: min(260px, 70vw); height: auto; filter: drop-shadow(0 14px 22px rgba(7, 52, 58, .18)); }
    .mp-note { font-size: 12px; color: var(--ink-soft); margin: 14px auto 0; max-width: 300px; line-height: 1.7; }

    .mp-controls fieldset { border: 0; padding: 0; margin: 0 0 22px; }
    .mp-controls legend { font-weight: 700; color: var(--navy); margin-bottom: 10px; }
    .mp-chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .mp-chips input, .mp-swatches input { position: absolute; opacity: 0; pointer-events: none; }
    .mp-chips span { display: inline-block; padding: 9px 16px; border-radius: 999px; background: #fff; border: 2px solid var(--line); cursor: pointer; font-weight: 500; }
    .mp-chips input:checked + span { border-color: var(--teal); background: var(--foam); color: var(--teal-dark); font-weight: 700; }
    .mp-chips input:focus-visible + span, .mp-swatches input:focus-visible + span { outline: 3px solid var(--teal-light); outline-offset: 2px; }
    .mp-swatches { display: flex; flex-wrap: wrap; gap: 12px; }
    .mp-swatches label { display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; }
    .mp-swatches span { width: 44px; height: 44px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 0 2px var(--line); }
    .mp-swatches input:checked + span { box-shadow: 0 0 0 3px var(--teal); }
    .mp-swatches small { font-size: 11px; color: var(--ink-soft); }
    .mp-text { width: 100%; padding: 12px 14px; border-radius: var(--radius-sm); border: 2px solid var(--line); font-size: 16px; background: #fff; }
    .mp-text:focus { outline: none; border-color: var(--teal); }
    .mp-help { font-size: 12px; color: var(--ink-soft); margin: 6px 0 0; }

    .mp-btn { display: inline-block; padding: 13px 26px; border-radius: 999px; background: var(--teal-dark); color: #fff; font-weight: 700; text-decoration: none; border: 2px solid var(--teal-dark); cursor: pointer; font-size: 15px; }
    .mp-btn.ghost { background: #fff; color: var(--teal-dark); }
    .mp-btn:hover { filter: brightness(1.08); }

    .mp-info { max-width: 720px; margin: 0 auto; line-height: 1.95; }
    .mp-info h2 { color: var(--navy); font-size: 22px; margin: 40px 0 14px; }
    .mp-flow { list-style: none; padding: 0; margin: 0; counter-reset: s; }
    .mp-flow li { counter-increment: s; position: relative; padding: 0 0 18px 48px; }
    .mp-flow li::before { content: counter(s); position: absolute; left: 0; top: 2px; width: 32px; height: 32px; border-radius: 50%; background: var(--ball); color: var(--ball-ink); font-weight: 800; display: grid; place-items: center; font-family: var(--display); }
    .mp-flow b { display: block; color: var(--ink); }
    .mp-flow span { color: var(--ink-soft); font-size: 15px; }
    .mp-cta { margin: 20px 0 8px; padding: 24px; border-radius: var(--radius); background: var(--foam); text-align: center; }
    .mp-price { font-family: var(--display); font-size: 28px; font-weight: 800; color: var(--navy); margin: 0 0 14px; }
    .mp-price small { font-size: 13px; font-weight: 500; color: var(--ink-soft); margin-left: 6px; }
    .mp-soon { margin: 0; color: var(--ink-soft); font-size: 15px; }

    @media (max-width: 760px) {
      .mp-studio { grid-template-columns: 1fr; padding: 20px 16px; }
    }
  </style>
</Base>
