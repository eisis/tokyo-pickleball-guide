---
// 記事トップ：src/content/posts/ のファイルを新しい順に並べる
import Base from '../../layouts/Base.astro';
import BlogArchive from '../../components/BlogArchive.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="記事" description="東京近郊のピックルボール情報。コートの体験レビュー、はじめ方やルールのガイド、新しいコートのニュースなど。">
  <BlogArchive
    posts={posts}
    allPosts={posts}
    eyebrow="Journal"
    title="記事"
    lead="実際にコートへ行って書いたレビューや、これから始める人のためのガイド、新しいコートのニュースを届けています。"
  />
</Base>
