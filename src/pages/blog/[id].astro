---
// 記事ページ：記事1ファイルにつき1ページ自動で作られる（例: /blog/tokyo-tower-review/）
// 上から：パンくず → タイトル → カバー画像 → 本文（横に目次）→ タグ・共有 → 紹介したコート → 関連記事
import { getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SnsLinks from '../../components/SnsLinks.astro';
import CourtCard from '../../components/CourtCard.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE, ldJson } from '../../lib/site';
import { ENVIRONMENTS, rentalText, reservationText } from '../../lib/courts';
import {
  getPosts, POST_CATEGORIES, categoryUrl, tagUrl, postUrl, ymd, readingMinutes, coverOf, relatedPosts, type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const courts = (await getEntries(d.courts.map((id) => ({ collection: 'courts' as const, id })))).filter(Boolean);
// コートレビューでは「屋内外・予約・レンタル」を必ず出す。記事に書いていない項目は、紹介コートのデータから自動で足す
const labels = new Set(d.facts.map((f) => f.label));
const main = d.category === 'review' ? courts[0] : undefined;
const facts = main
  ? [
      ...d.facts,
      ...(labels.has('コート') || labels.has('屋内/屋外') ? [] : [{ label: '屋内/屋外', value: main.data.environment.map((e) => ENVIRONMENTS[e].ja).join('・') }]),
      ...(labels.has('予約') || !main.data.reservation ? [] : [{ label: '予約', value: reservationText(main)! }]),
      ...(labels.has('レンタル') || !main.data.rental ? [] : [{ label: 'レンタル', value: rentalText(main)! }]),
    ]
  : d.facts;
const related = relatedPosts(post, await getPosts());
const cover = await coverOf(post);
const shareImage = d.banner ?? cover?.src; // リンク表示は横長のバナーを優先
const cat = POST_CATEGORIES[d.category];
// 本文にも同じ写真があるときは、上に重ねて出さない
const showCover = cover && !(post.body ?? '').includes(cover.src);
const url = new URL(postUrl(post), SITE.url).href;
const shareText = encodeURIComponent(`${d.title} | ${SITE.name}`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: d.title,
      description: d.description,
      datePublished: d.publishedAt.toISOString(),
      dateModified: (d.updatedAt ?? d.publishedAt).toISOString(),
      author: { '@type': 'Organization', name: d.author },
      publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      mainEntityOfPage: url,
      ...(shareImage ? { image: new URL(shareImage, SITE.url).href } : {}),
      keywords: d.tags.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'トップ', item: SITE.url + '/' },
        { '@type': 'ListItem', position: 2, name: '記事', item: SITE.url + '/blog/' },
        { '@type': 'ListItem', position: 3, name: cat.ja, item: SITE.url + categoryUrl(d.category) },
        { '@type': 'ListItem', position: 4, name: d.title, item: url },
      ],
    },
  ],
};
---

<Base title={d.title} description={d.description} image={shareImage}>
  <script slot="head" type="application/ld+json" set:html={ldJson(jsonLd)} />

  <article class="article">
    <header class="article-head">
      <nav class="crumbs" aria-label="パンくず">
        <a href="/">トップ</a><span aria-hidden="true">›</span>
        <a href="/blog/">記事</a><span aria-hidden="true">›</span>
        <a href={categoryUrl(d.category)}>{cat.ja}</a>
      </nav>
      <a class={`pcat pcat-${d.category}`} href={categoryUrl(d.category)}>{cat.ja}</a>
      <h1 class="article-title">{d.title}</h1>
      <p class="article-lead">{d.description}</p>
      <p class="article-meta">
        <time datetime={d.publishedAt.toISOString()}>{ymd(d.publishedAt)}</time>
        {d.updatedAt && <span>更新 {ymd(d.updatedAt)}</span>}
        <span>{readingMinutes(post)}分で読めます</span>
        <span>{d.author}</span>
      </p>
    </header>

    {showCover && (
      <figure class:list={["article-cover", { "fit-contain": d.coverFit === "contain" }]}>
        <img src={cover.src} alt={cover.alt} />
      </figure>
    )}

    {(d.points.length > 0 || facts.length > 0) && (
      <div class="article-summary">
        {d.points.length > 0 && (
          <section class="points" aria-label="この記事のポイント">
            <p class="points-label">この記事のポイント</p>
            <ol>{d.points.map((pt) => <li>{pt}</li>)}</ol>
          </section>
        )}
        {facts.length > 0 && (
          <section class="facts-box" aria-label="基本情報">
            <p class="points-label">{d.category === 'review' ? 'コート情報' : '基本情報'}</p>
            <dl>{facts.map((f) => <><dt>{f.label}</dt><dd>{f.value}</dd></>)}</dl>
          </section>
        )}
      </div>
    )}

    <div class="article-layout">
      {toc.length >= 2 && (
        <aside class="toc" aria-label="目次">
          <details open>
            <summary>この記事の目次</summary>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        </aside>
      )}

      <div class="article-body">
        <div class="prose"><Content /></div>

        <footer class="article-foot">
          {d.tags.length > 0 && (
            <div class="article-tags">{d.tags.map((t) => <a href={tagUrl(t)}>#{t}</a>)}</div>
          )}
          <div class="share">
            <span class="share-label">この記事をシェア</span>
            <a href={`https://x.com/intent/post?text=${shareText}&url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">X</a>
            <a href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">LINE</a>
            <button type="button" id="copy-link" data-url={url}>リンクをコピー</button>
          </div>
          <div class="follow">
            <p class="follow-label">新しいコート情報は SNS でもお届けしています</p>
            <SnsLinks place="article" />
          </div>
        </footer>
      </div>
    </div>

    {courts.length > 0 && (
      <section class="article-section">
        <h2 class="section-title">この記事で紹介したコート</h2>
        <div class="cards">{courts.map((c) => <CourtCard court={c!} />)}</div>
      </section>
    )}

    {related.length > 0 && (
      <section class="article-section">
        <h2 class="section-title">あわせて読みたい</h2>
        <div class="post-cards">{related.map((p) => <PostCard post={p} />)}</div>
      </section>
    )}

    <p class="article-back"><a href="/blog/">← 記事一覧へ</a></p>
  </article>

  <script>
    const btn = document.getElementById('copy-link') as HTMLButtonElement | null;
    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.url ?? location.href);
        btn.textContent = 'コピーしました';
      } catch {
        btn.textContent = 'コピーできませんでした';
      }
      setTimeout(() => (btn.textContent = 'リンクをコピー'), 2000);
    });
  </script>
</Base>
