---
// 記事ページ：記事1ファイルにつき1ページ自動で作られる（例: /blog/new-courts-autumn-2026/）
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CourtCard from '../../components/CourtCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const related = await getEntries(post.data.courts.map((id) => ({ collection: 'courts' as const, id })));
---

<Base title={post.data.title} description={post.data.description}>
  <main class="container narrow">
    <p class="meta"><a href="/blog/">← 記事一覧</a></p>
    <h1 style="margin:12px 0 8px;color:var(--navy)">{post.data.title}</h1>
    <p class="meta">
      {post.data.publishedAt.toISOString().slice(0, 10)}
      {post.data.updatedAt && `（更新 ${post.data.updatedAt.toISOString().slice(0, 10)}）`}
    </p>
    <article class="prose"><Content /></article>

    {related.length > 0 && (
      <section style="margin-top:40px">
        <h2 class="section-title">この記事で紹介したコート</h2>
        <div class="cards">{related.filter(Boolean).map((c) => <CourtCard court={c} />)}</div>
      </section>
    )}
  </main>
</Base>
