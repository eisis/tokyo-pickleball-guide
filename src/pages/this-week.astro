---
// 「今週どこで打てる？」：今日から7日間に開催されるイベントを、日ごとに並べる
// ・ビルド時は先の開催日をすべて出しておき、見た人の今日（日本時間）でスクリプトが7日分に振り分ける
//   （サイトを更新しなくても、毎日正しい「今週」になる）
// ・同じ日の中は Pickleball Tokyo 主催 → 開始時刻の順
import Base from '../layouts/Base.astro';
import TwItem from '../components/TwItem.astro';
import { getUpcomingEvents, EVENT_TYPES, venueOf, upcomingDates, startTime } from '../lib/events';
import { PREFECTURES, getCourts, sessionDates } from '../lib/courts';

const events = await getUpcomingEvents();
const items = (
  await Promise.all(
    events.map(async (e) => {
      const venue = await venueOf(e);
      return upcomingDates(e).map((date) => ({ e, venue, date }));
    })
  )
).flat();
// 種類のチップは、はじめての人がたどる順（体験 → 習う → 打つ → 試合 → イベント）に並べる
const TYPE_ORDER = ['trial', 'lesson', 'practice', 'tournament', 'festival'] as const;
// 施設の定期開催の枠（コートの sessions）も、イベントと同じ並びに混ぜる
const sessionItems = (await getCourts()).flatMap((c) => sessionDates(c).map((x) => ({ c, ...x })));
// イベントと定期開催をひとつの並びにする（同じ日の中は Pickleball Tokyo 主催 → 開始時刻の順）
const all = [
  ...items.map((x) => ({ kind: 'event' as const, ...x, self: x.e.data.organizer.self, time: startTime(x.e) || '99:99' })),
  ...sessionItems.map((x) => ({ kind: 'session' as const, c: x.c, s: x.s, date: x.date, self: false, time: (x.s.time.match(/\d{1,2}:\d{2}/)?.[0] ?? '99:99').padStart(5, '0') })),
];
const WEEK = ['日', '月', '火', '水', '木', '金', '土'];
const WEEK_EN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const base = Date.now() + 9 * 3600 * 1000;
const week = [...Array(7)].map((_, i) => {
  const x = new Date(base + i * 86400000);
  const d = x.toISOString().slice(0, 10);
  return {
    wd: x.getUTCDay(),
    head: i === 0 ? '今日' : i === 1 ? '明日' : `${WEEK[x.getUTCDay()]}曜`,
    headEn: i === 0 ? 'Today' : i === 1 ? 'Tomorrow' : WEEK_EN[x.getUTCDay()],
    sub: `${x.getUTCMonth() + 1}/${x.getUTCDate()}（${WEEK[x.getUTCDay()]}）`,
    subEn: `${x.getUTCMonth() + 1}/${x.getUTCDate()}`,
    list: all.filter((it) => it.date === d).sort((a, b) => Number(b.self) - Number(a.self) || a.time.localeCompare(b.time)),
  };
});
const prefs = (Object.keys(PREFECTURES) as (keyof typeof PREFECTURES)[]).filter((p) => items.some((x) => x.venue.prefecture === p) || sessionItems.some((x) => x.c.data.prefecture === p));
---

<Base
  title="今週どこで打てる？東京近郊のピックルボール練習会・体験会"
  description="今日から1週間のうちに東京・神奈川・千葉・埼玉で参加できるピックルボールの練習会・体験会・レッスン・大会を、日ごとにまとめました。初心者OK・予約不要でも絞り込めます。"
  en
>
  <header class="blog-head">
    <div class="blog-head-inner">
      <nav class="crumbs" aria-label="パンくず"><a href="/" data-ja="トップ" data-en="Home">トップ</a><span aria-hidden="true">›</span><a href="/events/" data-ja="イベント" data-en="Events">イベント</a><span aria-hidden="true">›</span><span data-ja="今週どこで打てる？" data-en="This week">今週どこで打てる？</span></nav>
      <p class="eyebrow">This Week</p>
      <h1 class="blog-title" data-ja="今週どこで打てる？" data-en="Where to play this week">今週どこで打てる？</h1>
      <p class="blog-lead" id="tw-range">今日から7日間に参加できる練習会・体験会・レッスン・大会です。コートを借りなくても、ひとりで行っても打てる場所が見つかります。</p>
    </div>
  </header>

  <main class="container events-page">
    <div class="event-filters" id="tw-filters">
      <div class="chips" role="group" aria-label="種類">
        <button type="button" class="chip active" data-type="all"><span data-ja="すべて" data-en="All">すべて</span> <span class="n" data-type-n="all"></span></button>
        {TYPE_ORDER.map((t) => <button type="button" class="chip" data-type={t}><span data-ja={EVENT_TYPES[t].ja} data-en={EVENT_TYPES[t].en}>{EVENT_TYPES[t].ja}</span> <span class="n" data-type-n={t}></span></button>)}
      </div>
      {prefs.length > 1 && (
        <div class="chips" role="group" aria-label="エリア">
          <button type="button" class="chip active" data-key="pref" data-value="all"><span data-ja="全エリア" data-en="All areas">全エリア</span></button>
          {prefs.map((p) => <button type="button" class="chip" data-key="pref" data-value={p}><span data-ja={PREFECTURES[p].ja} data-en={PREFECTURES[p].en}>{PREFECTURES[p].ja}</span></button>)}
        </div>
      )}
      <div class="chips" role="group" aria-label="条件">
        <button type="button" class="chip" data-toggle="beginner" aria-pressed="false"><span data-ja="初心者OK" data-en="Beginner OK">初心者OK</span></button>
        <button type="button" class="chip" data-toggle="walkin" aria-pressed="false"><span data-ja="予約不要" data-en="No booking">予約不要</span></button>
      </div>
    </div>

    <div class="tw-days" id="tw-days">
      {/* ビルドした日（日本時間）から7日分を最初からHTMLに並べておく（スクリプトを動かさない検索エンジン・AIにも中身が見える）。見た人の今日がずれていれば、下のスクリプトが並べ直す */}
      {week.map((w) => (
        <section class={`tw-day wd-${w.wd}${w.list.length ? '' : ' empty-day'}`}>
          <h2><span class="tw-head" data-ja={w.head} data-en={w.headEn}>{w.head}</span><span class="tw-sub" data-ja={w.sub} data-en={w.subEn}>{w.sub}</span><span class="tw-count">{w.list.length ? `${w.list.length}件` : ''}</span></h2>
          <div class="tw-list">{w.list.map((x) => <TwItem {...x} />)}</div>
          <p class="tw-none" data-ja="この日の掲載イベントはまだありません。" data-en="Nothing listed for this day yet.">この日の掲載イベントはまだありません。</p>
        </section>
      ))}
    </div>

    <template id="tw-pool">
      {all.map((x) => <TwItem {...x} />)}
    </template>

    <section class="event-bands">
      <div class="owner-band">
        <div class="owner-band-text">
          <p class="eyebrow">For Organizers</p>
          <h2 data-ja="練習会・体験会を載せませんか" data-en="List your open play or clinic">練習会・体験会を載せませんか</h2>
          <p data-ja="主催者の方がフォームから直接掲載できます。初回だけ内容を確認し、2回目からは同じメールアドレスで申し込むとすぐに公開されます。定期開催は日付をまとめて入れられます。" data-en="Organizers can list events directly through our form. We review your first submission; after that, submissions from the same email are published right away.">主催者の方がフォームから直接掲載できます。初回だけ内容を確認し、2回目からは同じメールアドレスで申し込むとすぐに公開されます。定期開催は日付をまとめて入れられます。</p>
        </div>
        <div class="owner-band-actions">
          <a class="owner-btn" href="/events/submit/" data-track="event_submit" data-track-from="今週" data-ja="イベントを掲載する" data-en="List an event">イベントを掲載する</a>
        </div>
      </div>
      <div class="event-note">
        <p data-ja="<b>決まった相手がいなくても大丈夫です。</b>練習会やオープンプレーは、集まった人同士で試合を回すものが多く、ひとりでの参加も歓迎されています。参加条件は各イベントのページでご確認ください。" data-en="<b>No partner? No problem.</b> Most open play sessions rotate games among whoever shows up, and solo players are welcome. Check each event page for details."><b>決まった相手がいなくても大丈夫です。</b>練習会やオープンプレーは、集まった人同士で試合を回すものが多く、ひとりでの参加も歓迎されています。参加条件は各イベントのページでご確認ください。</p>
        <a class="event-note-link" href="/#courts" data-ja="コートを借りて打つなら、コート一覧へ →" data-en="Want to rent a court? See the court list →">コートを借りて打つなら、コート一覧へ →</a>
      </div>
    </section>

    <p class="meta" data-ja="内容は変更されることがあります。参加前に必ず主催者のページで最新情報をご確認ください。" data-en="Details may change. Please check the organizer's page before you go.">内容は変更されることがあります。参加前に必ず主催者のページで最新情報をご確認ください。</p>
  </main>
</Base>

<script>
  const WEEK = ['日', '月', '火', '水', '木', '金', '土'];
  const base = Date.now() + 9 * 3600 * 1000; // 日本時間
  const days = [...Array(7)].map((_, i) => new Date(base + i * 86400000).toISOString().slice(0, 10));
  const WEEK_EN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const label = (d: string, i: number) => {
    const x = new Date(d + 'T00:00:00Z');
    const head = i === 0 ? '今日' : i === 1 ? '明日' : `${WEEK[x.getUTCDay()]}曜`;
    const headEn = i === 0 ? 'Today' : i === 1 ? 'Tomorrow' : WEEK_EN[x.getUTCDay()];
    return { head, headEn, sub: `${x.getUTCMonth() + 1}/${x.getUTCDate()}（${WEEK[x.getUTCDay()]}）`, subEn: `${x.getUTCMonth() + 1}/${x.getUTCDate()}`, wd: x.getUTCDay() };
  };

  // 7日分の枠を作って、イベントを振り分ける
  const wrap = document.getElementById('tw-days')!;
  wrap.innerHTML = ''; // 最初のHTML（ビルドした日の7日分）は、見た人の今日で作り直す
  const pool = (document.getElementById('tw-pool') as HTMLTemplateElement).content;
  const all = [...pool.querySelectorAll<HTMLElement>('[data-tw]')];
  const sections = days.map((d, i) => {
    const l = label(d, i);
    const sec = document.createElement('section');
    sec.className = `tw-day wd-${l.wd}`;
    sec.innerHTML = `<h2><span class="tw-head" data-ja="${l.head}" data-en="${l.headEn}">${l.head}</span><span class="tw-sub" data-ja="${l.sub}" data-en="${l.subEn}">${l.sub}</span><span class="tw-count"></span></h2><div class="tw-list"></div><p class="tw-none" data-ja="この日の掲載イベントはまだありません。" data-en="Nothing listed for this day yet.">この日の掲載イベントはまだありません。</p>`;
    const list = sec.querySelector('.tw-list')!;
    all
      .filter((el) => el.dataset.date === d)
      .sort((a, b) => Number(b.dataset.self) - Number(a.dataset.self) || (a.dataset.time ?? '').localeCompare(b.dataset.time ?? ''))
      .forEach((el) => list.append(el));
    wrap.append(sec);
    return sec;
  });
  const first = new Date(days[0] + 'T00:00:00Z'), last = new Date(days[6] + 'T00:00:00Z');
  const range = document.getElementById('tw-range')!;
  const span = `${first.getUTCMonth() + 1}/${first.getUTCDate()}〜${last.getUTCMonth() + 1}/${last.getUTCDate()}`;
  range.dataset.ja = `${span}に参加できる練習会・体験会・レッスン・大会です。コートを借りなくても、ひとりで行っても打てる場所が見つかります。`;
  range.dataset.en = `Open play, clinics, lessons and tournaments you can join ${span.replace('〜', '–')}. Find places to play without booking a court, even on your own.`;
  range.textContent = range.dataset.ja;

  // 絞り込み
  const root = document.getElementById('tw-filters')!;
  const TYPES = ['all', 'trial', 'lesson', 'practice', 'tournament', 'festival'];
  const fromUrl = new URLSearchParams(location.search).get('type') ?? 'all';
  const state = { pref: 'all', beginner: false, walkin: false, type: TYPES.includes(fromUrl) ? fromUrl : 'all' };
  // 7日間に開催がある種類だけチップを出し、件数を付ける
  const inWeek = sections.flatMap((sec) => [...sec.querySelectorAll<HTMLElement>('[data-tw]')]);
  root.querySelectorAll<HTMLElement>('[data-type-n]').forEach((n) => {
    const t = n.dataset.typeN!;
    const c = inWeek.filter((el) => t === 'all' || el.dataset.type === t).length;
    n.textContent = String(c);
    if (t !== 'all' && c === 0) (n.closest('.chip') as HTMLElement).hidden = true;
  });
  function apply() {
    sections.forEach((sec) => {
      let n = 0;
      sec.querySelectorAll<HTMLElement>('[data-tw]').forEach((el) => {
        const ok = (state.type === 'all' || el.dataset.type === state.type) && (state.pref === 'all' || el.dataset.pref === state.pref) && (!state.beginner || el.dataset.beginner === '1') && (!state.walkin || el.dataset.walkin === '1');
        el.hidden = !ok;
        if (ok) n++;
      });
      sec.querySelector<HTMLElement>('.tw-count')!.textContent = n ? ((window as any).currentLang === 'en' ? `${n}` : `${n}件`) : '';
      sec.classList.toggle('empty-day', n === 0);
    });
    root.querySelectorAll<HTMLButtonElement>('.chip[data-key]').forEach((b) => b.classList.toggle('active', state.pref === b.dataset.value));
    root.querySelectorAll<HTMLButtonElement>('.chip[data-type]').forEach((b) => b.classList.toggle('active', state.type === b.dataset.type));
    // 種類はURLにも残す（?type=trial のリンクをSNSで共有できる）
    const u = new URL(location.href);
    state.type === 'all' ? u.searchParams.delete('type') : u.searchParams.set('type', state.type);
    history.replaceState(null, '', u);
    root.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((b) => {
      const on = state[b.dataset.toggle as 'beginner' | 'walkin'];
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', String(on));
    });
  }
  root.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    const t = el.closest<HTMLButtonElement>('[data-toggle]');
    if (t) state[t.dataset.toggle as 'beginner' | 'walkin'] = !state[t.dataset.toggle as 'beginner' | 'walkin'];
    const ty = el.closest<HTMLButtonElement>('.chip[data-type]');
    if (ty) state.type = ty.dataset.type!;
    const b = el.closest<HTMLButtonElement>('.chip[data-key]');
    if (b) state.pref = b.dataset.value!;
    apply();
  });
  apply();
  // スクリプトで作った見出しにも今の言語を当て、切り替えたら件数の表記も直す
  (window as any).applyLang?.();
  window.addEventListener('lang:change', () => sections.forEach((sec) => { const n = sec.querySelectorAll('[data-tw]:not([hidden])').length; sec.querySelector<HTMLElement>('.tw-count')!.textContent = n ? ((window as any).currentLang === 'en' ? `${n}` : `${n}件`) : ''; }));
</script>
