---
// コート詳細ページ：コート1ファイルにつき1ページ自動で作られる（例: /courts/kpi-park/）
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CourtMap from '../../components/CourtMap.astro';
import EventCard from '../../components/EventCard.astro';
import { getUpcomingEvents } from '../../lib/events';
import { getCourts, PREFECTURES, ENVIRONMENTS, mapUrl, isNew, rentalText, reservationText, type Court } from '../../lib/courts';

export async function getStaticPaths() {
  const courts = await getCourts();
  return courts.map((court) => ({ params: { id: court.id }, props: { court } }));
}

const { court } = Astro.props as { court: Court };
const d = court.data;
const { Content } = await render(court);
const courtEvents = (await getUpcomingEvents()).filter((e) => e.data.court === court.id);
const env = d.environment.map((e) => ENVIRONMENTS[e].ja).join('・');
const pref = PREFECTURES[d.prefecture].full;
const bookLabel = d.booking.label === 'info' ? '公式サイトで詳細を見る →' : '公式サイトで予約する →';
const ymd = (date: Date) => date.toISOString().slice(0, 10);
const desc = `${d.name}（${pref}・${d.area.ja}）のピックルボールコート情報。${d.description.ja}`;
---

<Base title={`${d.name}｜${d.area.ja}のピックルボールコート`} description={desc} image={d.image}>
  <main class="container narrow">
    <p class="meta"><a href="/">← コート一覧</a></p>
    <h1 style="margin:12px 0 20px;color:var(--navy)">{d.name}{isNew(court) && <span class="new-label">NEW</span>}</h1>
    {d.ownerVerified && <p class="owner-verified">✓ 施設の運営者が掲載している情報です</p>}

    {d.image ? (
      <img class="detail-hero" src={d.image} alt={d.name} />
    ) : (
      <div class="detail-hero image-placeholder" aria-hidden="true">🏓</div>
    )}

    <p class="description" style="margin-top:20px">{d.description.ja}</p>

    <dl class="facts">
      <dt>エリア</dt><dd>{pref} {d.area.ja}</dd>
      <dt>屋内/屋外</dt><dd>{env}</dd>
      {d.reservation && (<><dt>予約方法</dt><dd>{reservationText(court)}</dd></>)}
      {d.rental && (<><dt>レンタル</dt><dd>{rentalText(court)}</dd></>)}
      {d.courts && (<><dt>面数</dt><dd>{d.courts}面</dd></>)}
      {d.address && (<><dt>住所</dt><dd>{d.address}</dd></>)}
      {d.access && (<><dt>アクセス</dt><dd>{d.access.ja}</dd></>)}
      {d.hours && (<><dt>営業時間</dt><dd>{d.hours}</dd></>)}
      {d.price && (<><dt>料金の目安</dt><dd>{d.price}</dd></>)}
      {d.openedAt && (<><dt>オープン</dt><dd>{ymd(d.openedAt)}</dd></>)}
    </dl>

    <a class="button" href={d.booking.url} target="_blank" rel="noopener" data-track="booking" data-track-from="詳細ページ" data-court-id={court.id} data-court-name={d.name}>{bookLabel}</a>
    {d.availabilityUrl && <a class="button secondary" href={d.availabilityUrl} target="_blank" rel="noopener" data-track="availability" data-track-from="詳細ページ" data-court-id={court.id} data-court-name={d.name}>空き状況を見る</a>}
    <a class="map-button" href={mapUrl(court)} target="_blank" rel="noopener" data-track="map" data-track-from="詳細ページ" data-court-id={court.id} data-court-name={d.name}>📍 Google Map</a>

    <div class="prose"><Content /></div>

    {courtEvents.length > 0 && (
      <section style="margin-top:28px">
        <h2 style="font-size:1.1rem;color:var(--navy);margin-bottom:12px">このコートで開催予定のイベント</h2>
        <div class="event-list">{courtEvents.map((e) => <EventCard event={e} />)}</div>
      </section>
    )}

    {d.location && <div style="margin-top:28px"><CourtMap courts={[court]} /></div>}

    <p class="meta">情報確認日：{ymd(d.updatedAt)}　料金・営業時間は変わることがあるため、最新情報は公式サイトでご確認ください。</p>

    <aside class="owner-note">
      <div>
        <p class="owner-note-title">このコートの運営者の方へ</p>
        <p>料金・営業時間・写真などの掲載内容は、運営者の方がフォームから直接更新できます。空き状況の表示や予約連携のご相談もあわせて受け付けています。</p>
      </div>
      <a class="owner-note-btn" href={`/owners/?court=${court.id}`} data-track="owner_update" data-track-from="詳細ページ" data-court-id={court.id} data-court-name={d.name}>掲載内容を更新する</a>
    </aside>
    <p class="meta"><a href="/contact/?type=fix">掲載情報の誤りを報告する（利用者の方）</a></p>
    {d.sources.length > 0 && (
      <div class="sources">
        <p>参考</p>
        <ul>{d.sources.map((s) => <li><a href={s} target="_blank" rel="noopener">{new URL(s).hostname}</a></li>)}</ul>
      </div>
    )}
  </main>
</Base>
