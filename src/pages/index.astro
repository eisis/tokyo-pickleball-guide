---
// トップページ：地図 → 絞り込み → コートカード → 新着記事
// コートは src/content/courts/ のファイルから自動で読み込まれる
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CourtMap from '../components/CourtMap.astro';
import CourtFilters from '../components/CourtFilters.astro';
import CourtCard from '../components/CourtCard.astro';
import { getCourts } from '../lib/courts';
import { SITE } from '../lib/site';

const courts = await getCourts();
const prefectures = [...new Set(courts.map((c) => c.data.prefecture))];
const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<Base
  title="東京近郊のピックルボールコートまとめ"
  description={SITE.description}
>
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline>
      <source src="/pickleball-hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>{SITE.name}</h1>
      <p data-ja={SITE.lead.ja} data-en={SITE.lead.en} set:html={SITE.lead.ja} />
    </div>
  </section>

  <main class="container">
    <h2 class="section-title" data-ja="コートマップ" data-en="Court Map">コートマップ</h2>
    <CourtMap courts={courts} />
    <CourtFilters prefectures={prefectures} total={courts.length} />

    <section class="cards">
      {courts.map((court) => <CourtCard court={court} />)}
    </section>

    {posts.length > 0 && (
      <section style="margin-top:56px">
        <h2 class="section-title" data-ja="新着記事" data-en="Latest Articles">新着記事</h2>
        <div class="post-list">
          {posts.map((p) => (
            <div class="post-item">
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              <p class="meta">{p.data.publishedAt.toISOString().slice(0, 10)}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>
</Base>
