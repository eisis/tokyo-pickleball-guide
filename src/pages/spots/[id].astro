---
// 駅・街の単位のコートまとめ（例: /spots/toyosu/）。「豊洲 ピックルボール」のような地名検索の受け皿
// 料金・時間・アクセスはコートのファイルの値をそのまま出す（推測の文章は書かない）
import Base from '../../layouts/Base.astro';
import CourtCard from '../../components/CourtCard.astro';
import CourtMap from '../../components/CourtMap.astro';
import CourtTable from '../../components/CourtTable.astro';
import { getCourts, PREFECTURES, courtUrl } from '../../lib/courts';
import { SPOTS, type SpotId } from '../../lib/spots';
import { SITE, ldJson } from '../../lib/site';

export function getStaticPaths() {
  return (Object.keys(SPOTS) as SpotId[]).map((id) => ({ params: { id }, props: { id } }));
}
const { id } = Astro.props as { id: SpotId };
const S = SPOTS[id];
const all = await getCourts();
const courts = (S.courts as readonly string[]).map((c) => all.find((x) => x.id === c)).filter((c): c is NonNullable<typeof c> => !!c);
const P = PREFECTURES[S.pref];
const indoor = courts.filter((c) => c.data.environment.includes('indoor')).length;
const outdoor = courts.filter((c) => c.data.environment.includes('outdoor')).length;
const latest = courts.length ? new Date(Math.max(...courts.map((c) => c.data.updatedAt.getTime()))).toISOString().slice(0, 10) : '';
const pageUrl = `${SITE.url}/spots/${id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ItemList', name: `${S.ja}のピックルボールコート`, itemListElement: courts.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.data.name, url: SITE.url + courtUrl(c) })) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: `${P.ja}のコート`, item: `${SITE.url}/areas/${S.pref}/` },
      { '@type': 'ListItem', position: 3, name: `${S.ja}のコート`, item: pageUrl },
    ] },
  ],
};
---

<Base
  title={`${S.ja}でピックルボールができる場所（${courts.length}か所）｜料金・アクセス比較`}
  description={`${S.ja}のピックルボールコート${courts.length}か所（${courts.map((c) => c.data.name).join('・')}）を、屋内・屋外、料金、営業時間、アクセスで比べられます。公式情報で確認した内容だけを載せています。`}
  en
>
  <script slot="head" type="application/ld+json" set:html={ldJson(jsonLd)} />
  <main class="container">
    <nav class="crumbs" aria-label="パンくず"><a href="/" data-ja="トップ" data-en="Home">トップ</a><span aria-hidden="true">›</span><a href={`/areas/${S.pref}/`} data-ja={`${P.ja}のコート`} data-en={`Courts in ${P.en}`}>{P.ja}のコート</a><span aria-hidden="true">›</span><span data-ja={S.ja} data-en={S.en}>{S.ja}</span></nav>
    <h1 style="margin:0 0 12px;color:var(--navy)" data-ja={`${S.ja}でピックルボールができる場所`} data-en={`Where to play pickleball in ${S.en}`}>{S.ja}でピックルボールができる場所</h1>
    <p class="description" data-ja={`${S.lead}掲載しているのは${courts.length}か所で、屋内が${indoor}か所、屋外が${outdoor}か所です。`} data-en={`${S.leadEn} We list ${courts.length} places: ${indoor} indoor and ${outdoor} outdoor.`}>{S.lead}掲載しているのは{courts.length}か所で、屋内が{indoor}か所、屋外が{outdoor}か所です。</p>
    <p class="meta" data-ja={`情報の最終確認日：${latest}`} data-en={`Last checked: ${latest}`}>情報の最終確認日：{latest}</p>

    <div style="margin-top:20px"><CourtTable courts={courts} /></div>

    <div class="cards" style="margin-top:28px">{courts.map((c) => <CourtCard court={c} />)}</div>
    {courts.some((c) => c.data.location) && <div style="margin-top:28px"><CourtMap courts={courts} /></div>}

    <section style="margin-top:36px">
      <h2 style="font-size:1.1rem;color:var(--navy);margin-bottom:10px" data-ja="ほかの場所から探す" data-en="Find more places">ほかの場所から探す</h2>
      <p class="meta"><a href={`/areas/${S.pref}/`} data-ja={`${P.ja}のコート一覧へ`} data-en={`All courts in ${P.en}`}>{P.ja}のコート一覧へ</a>　<a href="/this-week/" data-ja="今週参加できる練習会・体験会" data-en="Open play &amp; clinics this week">今週参加できる練習会・体験会</a></p>
    </section>
    <p class="meta" data-ja="料金・営業時間は変わることがあります。最新情報は各施設の公式サイトでご確認ください。" data-en="Prices and hours may change. Please check each official site.">料金・営業時間は変わることがあります。最新情報は各施設の公式サイトでご確認ください。</p>
  </main>
</Base>
